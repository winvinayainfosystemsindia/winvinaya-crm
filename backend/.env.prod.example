# WinVinaya CRM - Production Environment Variables
# Copy to backend/.env.prod

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=winvinaya_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=winvinaya_prod_db_2026

# Application Configuration
SECRET_KEY=wv_prod_secret_3c7f1a9e5b2d8f4a6c0e9b3d7f1a5c8e2b6d0f4a9c3e7b1d5f8a2c6e0b4d9f3a
ANALYTICS_SECRET_KEY=winvinaya-crm-analytics-secret-prod-789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=production

# CORS Configuration
BACKEND_CORS_ORIGINS=["https://crm.winvinaya.com","https://www.crm.winvinaya.com"]

# Rate Limiting
RATE_LIMIT_ENABLED=true
REDIS_URL=memory://

# Admin User
FIRST_SUPERUSER=admin@winvinaya.com
FIRST_SUPERUSER_PASSWORD=your_strong_password_here

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@winvinaya.com
SMTP_PASSWORD=your_production_app_password
EMAILS_FROM_EMAIL=noreply@winvinaya.com

# File Upload
MAX_UPLOAD_SIZE=10485760  # 10MB
ALLOWED_EXTENSIONS=["pdf","jpg","jpeg","png","doc","docx"]

# API Documentation
PROJECT_NAME="WinVinaya CRM"

# Logging
LOG_LEVEL=INFO

# Claude MCP Connector (Streamable HTTP + OAuth 2.1)
MCP_ISSUER_URL=https://crm.winvinaya.com/mcp
MCP_TOKEN_SECRET=mT6zQ1vK9pR3xB8nW5cH2jF7dL4aY0s
MCP_ALLOWED_ROLES=admin
MCP_ACCESS_TOKEN_EXPIRE_SECONDS=3600
MCP_REFRESH_TOKEN_EXPIRE_SECONDS=2592000
MCP_AUTH_CODE_EXPIRE_SECONDS=300
MCP_MAX_ROWS=50

