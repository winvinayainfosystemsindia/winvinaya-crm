# WinVinaya CRM - Development Environment Variables
# Copy to backend/.env.dev

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=winvinaya_dev
POSTGRES_USER=winvinaya_user
POSTGRES_PASSWORD=winvinaya12345

# Application Configuration
SECRET_KEY=wv_dev_secret_8a4f2c9e1b7d3f6a0c5e8b2d4f9a1c7e3b6d0f8a2c4e9b1d7f3a5c8e0b2d6f4a
ANALYTICS_SECRET_KEY=winvinaya-crm-analytics-secret-123
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=development

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://dev-crm.winvinaya.com"]

# Rate Limiting
RATE_LIMIT_ENABLED=true
REDIS_URL=memory://

# Admin User (for initial setup)
FIRST_SUPERUSER=admin@winvinaya.com
FIRST_SUPERUSER_PASSWORD=changeme123

# Email Configuration (optional for dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@winvinaya.com

# File Upload
MAX_UPLOAD_SIZE=10485760  # 10MB
ALLOWED_EXTENSIONS=["pdf","jpg","jpeg","png","doc","docx"]

# API Documentation
PROJECT_NAME="WinVinaya CRM - Development"

# Claude MCP Connector (Streamable HTTP + OAuth 2.1)
MCP_ISSUER_URL=https://dev-crm.winvinaya.com/mcp
MCP_TOKEN_SECRET=7fK9mQ2xR8vN4pL6zT1wB5cH0jY3dA9s
MCP_ALLOWED_ROLES=admin
MCP_ACCESS_TOKEN_EXPIRE_SECONDS=3600
MCP_REFRESH_TOKEN_EXPIRE_SECONDS=2592000
MCP_AUTH_CODE_EXPIRE_SECONDS=300
MCP_MAX_ROWS=50

